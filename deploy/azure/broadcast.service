[Unit]
Description=Broadcast Copilot containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/broadcast
ExecStart=/usr/bin/docker compose -p broadcast -f compose.azure.yaml up --no-build -d
ExecStop=/usr/bin/docker compose -p broadcast -f compose.azure.yaml stop
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

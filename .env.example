# Fill these in locally after creating a Foundry model deployment.
# Use the Azure OpenAI v1 inference endpoint, not the project endpoint.
FOUNDRY_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# Optional: keep the active SQLite database outside synced/network folders.
# EDITORIAL_DB_PATH=C:/broadcast-data/editorial.sqlite3

# Set to 1 only for a dedicated public synthetic demo.
# PUBLIC_DEMO_MODE=1
